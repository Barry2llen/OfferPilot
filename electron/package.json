{
  "name": "offer-pilot-electron",
  "private": true,
  "version": "0.0.5",
  "description": "OfferPilot desktop application.",
  "author": {
    "name": "Barry2llen",
    "email": "62414767+Barry2llen@users.noreply.github.com"
  },
  "homepage": "https://github.com/Barry2llen/OfferPilot",
  "desktopName": "offerpilot.desktop",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.15.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/install-electron.mjs",
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "build:electron": "tsc && vite build",
    "build:frontend": "node scripts/build.mjs frontend",
    "build:backend": "node scripts/build.mjs backend",
    "build:win": "node scripts/build.mjs windows",
    "build:linux": "node scripts/build.mjs linux",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:linux": "node --experimental-strip-types scripts/smoke-linux.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "playwright-core": "1.64.1",
    "typescript": "^5.2.2",
    "vite": "^7.3.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "main": "dist-electron/main.js",
  "allowScripts": {
    "electron@30.5.1": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.1": true
  }
}
